#!/usr/bin/env bash
# Run all five models (normal load levels + one failure run each), then restore the stack.
# Takes roughly 25 to 30 minutes. Results: /vagrant/m8_results.csv
set -u
source "$(dirname "$(readlink -f "$0")")/m8-lib"
check_cluster || exit 1
[ -s "$OUT" ] && { mv "$OUT" "$OUT.$(date +%Y%m%d-%H%M%S).bak"; say "old results backed up"; }
for m in host workstation server pool integrated; do
  "$HERE/m8-run-model" "$m" --fail || { say "${R}${B}$m failed. Fix the cause and rerun: m8-run-model $m --fail (remaining models after it too)${N}"; "$HERE/m8-baseline" --with-device; exit 1; }
  say "cooldown 20 s"; sleep 20
done
"$HERE/m8-baseline" --with-device
"$HERE/m8-results"
